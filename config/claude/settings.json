{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GH_CONFIG_DIR": "${HOME}/.config/gh-coding-agent",
    "GIT_CONFIG_COUNT": "6",
    "GIT_CONFIG_KEY_0": "user.signingkey",
    "GIT_CONFIG_VALUE_0": "${HOME}/.ssh/id_ed25519_coding_agent_signing.pub",
    "GIT_CONFIG_KEY_1": "gpg.ssh.program",
    "GIT_CONFIG_VALUE_1": "ssh-keygen",
    "GIT_CONFIG_KEY_2": "url.https://github.com/.insteadOf",
    "GIT_CONFIG_VALUE_2": "git@github.com:",
    "GIT_CONFIG_KEY_3": "url.https://github.com/.insteadOf",
    "GIT_CONFIG_VALUE_3": "ssh://git@github.com/",
    "GIT_CONFIG_KEY_4": "credential.helper",
    "GIT_CONFIG_VALUE_4": "",
    "GIT_CONFIG_KEY_5": "credential.https://github.com.helper",
    "GIT_CONFIG_VALUE_5": "!gh auth git-credential",
    "SSH_AUTH_SOCK": "${HOME}/.local/state/coding-agent/ssh-agent.sock"
  },
  "permissions": {
    "allow": [
      "Bash(gh auth status *)",
      "Bash(gh cache list *)",
      "Bash(gh gist list *)",
      "Bash(gh gist view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue status *)",
      "Bash(gh issue view *)",
      "Bash(gh label list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr close *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr list *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr reopen *)",
      "Bash(gh pr revert *)",
      "Bash(gh pr review *)",
      "Bash(gh pr status *)",
      "Bash(gh pr view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh repo list *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh search *)",
      "Bash(gh status *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(wget *)"
    ],
    "ask": [
      "Bash(aws *)",
      "Bash(gh api *)",
      "Bash(gh issue close *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue reopen *)",
      "Bash(gh pr merge *)",
      "Bash(git push *)",
      "Edit(Cargo.toml)",
      "Edit(Cargo.lock)",
      "Edit(build.rs)"
    ]
  },
  "outputStyle": "Concise",
  "attribution": {
    "sessionUrl": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/reload-global-instructions.sh",
            "statusMessage": "Reloading global instructions..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/start-coding-agent-ssh-agent.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/remind-japanese-opening.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pr-review-toolkit@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    }
  },
  "language": "Japanese",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "herdr *"
    ],
    "filesystem": {
      "denyRead": [
        "~/.aws",
        "~/.config",
        "~/.docker",
        "~/.gnupg",
        "~/.kube",
        "~/.netrc",
        "~/.npmrc",
        "~/.pypirc",
        "~/.ssh",
        "~/Library/Keychains",
        "~/**/.env"
      ],
      "allowRead": [
        "~/.config/cmux",
        "~/.config/gh-coding-agent",
        "~/.config/ghostty",
        "~/.config/git/attributes",
        "~/.config/git/ignore",
        "~/.config/nvim",
        "~/.config/zsh",
        "~/.ssh/id_ed25519_coding_agent_signing.pub"
      ]
    },
    "network": {
      "allowUnixSockets": [
        "${HOME}/.local/state/coding-agent/ssh-agent.sock"
      ],
      "allowedDomains": [
        "api.github.com",
        "crates.io",
        "files.pythonhosted.org",
        "formulae.brew.sh",
        "ghcr.io",
        "github.com",
        "objects.githubusercontent.com",
        "pypi.org",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "static.crates.io"
      ]
    }
  },
  "alwaysThinkingEnabled": false,
  "tui": "fullscreen"
}
