# --- Theme / Font ----------------------------------------------
theme = Catppuccin Mocha
font-family = "PlemolJP Console NF"
font-style = Text
font-size = 13

# Disable ligatures so that sequences such as -> and != stay as separate glyphs
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# --- Transparency / Blur --------------------------------------
# Let the desktop show through slightly behind the terminal
background-opacity = 0.95
background-blur = true

# --- Window / Padding -------------------------------------------
# Keep some margin so text does not sit too close to the window edge
window-padding-x = 8
window-padding-y = 8

# Restore window state on restart
window-save-state = always

# --- Security ---------------------------------------------------
# Automatically enable Secure Keyboard Entry when entering a password
macos-auto-secure-input = true
